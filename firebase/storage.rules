rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid}/inventories/{file} {
      allow read, delete: if owner(uid);
      allow create: if owner(uid) && file.matches('[A-Za-z0-9-]+[.]json')
        && request.resource.size <= 10000000 && request.resource.contentType == 'application/json';
      allow update: if false;
    }
    match /users/{uid}/scans/{asset} {
      allow read, delete: if owner(uid);
      allow create: if owner(uid) && request.resource.size <= 30000000
        && request.resource.contentType == 'application/octet-stream';
      allow update: if false;
    }
  }
}
